# Regenerable backtest/discovery artifacts -- don't commit stale/misleading data
backtest/cache/
backtest/results/
research/results/

# Local Phantom MCP session (wallet session keys) must NEVER be committed
.phantom-mcp/
*session.json

# Trade journal is real trading history -- keep it local by default.
# Remove this line if you deliberately want to version-control your trade log.
journal/trades.jsonl

# Paper-trading state/journal -- regenerates fresh on first run
# (paper_trading/run_paper_cycle.py creates it automatically), and stays
# local since it's a running simulation, not source.
state/paper_portfolio.json
journal/paper_trades.jsonl

# Regime filter cache (paper_trading/run_paper_cycle.py) -- short-lived
# (REGIME_CACHE_TTL_SECONDS), regenerates automatically, not source.
state/regime_cache.json

# Per-candidate price-history cache (paper_trading/run_paper_cycle.py) --
# same reasoning, short-lived (PRICE_HISTORY_CACHE_TTL_SECONDS).
state/price_history_cache/

# Discovery rotation history (paper_trading/run_paper_cycle.py) -- a rolling
# FIFO of recently-evaluated mints so discovery's max_candidates cap rotates
# across cycles instead of always favoring the same head-of-list tokens.
state/discovery_rotation.json

# Cross-process lock guarding a paper-trading cycle's state read-modify-write
# (paper_trading/run_paper_cycle.py's CycleLock) -- exists only for the
# duration of one cycle, never meant to be committed.
state/paper_cycle.lock

# Live starting-capital baseline -- created by trade-cycle's first real
# cycle from the wallet's actual funded balance (see config/risk.yaml
# "Capital" and trade-cycle SKILL.md step 2). There's no fixed/shipped
# value for this (no assumed $ amount), so unlike circuit_breaker.json it
# has nothing meaningful to track before it exists.
state/starting_capital.json

# state/circuit_breaker.json IS tracked (it ships with an initial
# tripped:false state); it will show as locally modified once the agent
# starts updating it. That's expected -- commit or not, your call.

__pycache__/
*.pyc
.DS_Store
